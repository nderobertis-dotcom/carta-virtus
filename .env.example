# .env.example — copia in .env e compila con i valori reali
# Trovale in: Supabase → Settings → API

SUPABASE_URL=https://brwkwlyxkptzmkzkava.supabase.co
SUPABASE_ANON_KEY=eyJ...          # Project API Keys → anon public
SUPABASE_SERVICE_KEY=eyJ...       # Project API Keys → service_role (TIENI SEGRETO)

# Porta del server (se usi Express / Fastify)
PORT=3000

# JWT secret (stesso di Supabase → Settings → API → JWT Secret)
SUPABASE_JWT_SECRET=your-jwt-secret

# OneSignal (per notifiche push — stesso setup di VolleyLive)
ONESIGNAL_APP_ID=
ONESIGNAL_REST_KEY=

# EmailJS o Resend (per email transazionali)
EMAIL_FROM=noreply@cartavirtus.it
RESEND_API_KEY=
